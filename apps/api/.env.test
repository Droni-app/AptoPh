PORT=3334
# Database (PostgreSQL local)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=dev
DB_PASSWORD=dev01
DB_DATABASE=aptoph_test

# Mail: tests never use real SMTP credentials (mail.fake() in specs)
MAIL_FROM_NAME=AptoPH
MAIL_FROM_ADDRESS=no-reply@aptoph.test
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

# Rate limits kept in memory during tests
LIMITER_STORE=memory

# Files: never the real bucket (specs also use drive.fake())
DRIVE_DISK=fs

# Wompi: fake keys; tests never call Wompi (the client is replaced by a fake)
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=pub_test_fake
WOMPI_PRIVATE_KEY=prv_test_fake
WOMPI_EVENTS_SECRET=test_events_fake
WOMPI_INTEGRITY_SECRET=test_integrity_fake
