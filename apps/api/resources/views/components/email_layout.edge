<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title ?? brandName }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f6f8;font-family:Arial,Helvetica,sans-serif;color:#1d2433;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f6f8;padding:24px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border:1px solid #d6dbe3;border-radius:12px;">
          <tr>
            <td style="padding:24px 28px;border-bottom:1px solid #e6e9ef;font-size:20px;font-weight:bold;color:#1e3a5f;">
              {{ brandName }}
            </td>
          </tr>
          <tr>
            <td style="padding:28px;font-size:15px;line-height:1.6;">
              {{{ await $slots.main() }}}
            </td>
          </tr>
          <tr>
            <td style="padding:16px 28px;border-top:1px solid #e6e9ef;font-size:12px;color:#5b6475;">
              Este es un mensaje automático de {{ brandName }}. Por favor no respondas a este correo.
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
