{{-- Call-to-action button for emails: url and label --}}
<p style="margin:0 0 24px;">
  <a href="{{ url }}" style="display:inline-block;background:#1e3a5f;color:#ffffff;text-decoration:none;font-weight:600;padding:12px 20px;border-radius:8px;">{{ label }}</a>
</p>
<p style="margin:0 0 16px;color:#5b6475;font-size:13px;">Si el botón no funciona, copia este enlace en tu navegador:<br><a href="{{ url }}" style="color:#1e3a5f;word-break:break-all;">{{ url }}</a></p>
