# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# Ignored in development (any origin is allowed)
# CORS_ORIGINS=https://web.aptoph.com,https://admin.aptoph.com

# Production OAuth clients (database/seeders/production_seeder.ts)
# WEB_URL=https://web.aptoph.com
# BACKOFFICE_URL=https://admin.aptoph.com

# Database (PostgreSQL local)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=aptoph
DB_PASSWORD=aptoph
DB_DATABASE=aptoph
# CA certificate of a managed database; enables TLS when set
# DB_CA_CERT=

# Mail (SMTP · Mailjet: usuario = API key, contraseña = Secret key)
MAIL_MAILER=smtp
MAIL_FROM_NAME=AptoPH
MAIL_FROM_ADDRESS=noreply@aptoph.com
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
