# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# Ignored in development (any origin is allowed)
# CORS_ORIGINS=https://web.aptoph.com,https://admin.aptoph.com

# Public URLs of the web apps, for links sent by email (invitations, password reset…)
# BACKOFFICE_URL=https://admin.aptoph.com
# RESIDENTS_URL=https://web.aptoph.com

# Database (PostgreSQL local)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=aptoph
DB_PASSWORD=aptoph
DB_DATABASE=aptoph
# CA certificate of a managed database; enables TLS when set
# DB_CA_CERT=

# Mail (SMTP · Mailjet: usuario = API key, contraseña = Secret key)
MAIL_MAILER=smtp
MAIL_FROM_NAME=AptoPH
MAIL_FROM_ADDRESS=noreply@aptoph.com
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Buzón que recibe las solicitudes de activación de plan (opcional)
# SALES_EMAIL=ventas@aptoph.com
# Rate limits (login, password reset, invitations): database or memory
LIMITER_STORE=database
# Archivos (docs/files.md): fs = carpeta ./storage (desarrollo), spaces = DigitalOcean Spaces
DRIVE_DISK=fs
# SPACES_KEY=
# SPACES_SECRET=
# SPACES_REGION=nyc3
# SPACES_BUCKET=aptoph
# SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com

# Wompi (pagos de los conjuntos a AptoPH). docs/billing.md
# Sandbox: pub_test_ / prv_test_ / test_events_ / test_integrity_
# Producción: pub_prod_ / prv_prod_ / prod_events_ / prod_integrity_
# WOMPI_ENV=sandbox
# WOMPI_PUBLIC_KEY=
# WOMPI_PRIVATE_KEY=
# WOMPI_EVENTS_SECRET=
# WOMPI_INTEGRITY_SECRET=
